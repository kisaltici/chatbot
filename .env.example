# ─── Panel ─────────────────────────────────────────────
# Web panelinin şifresi (zorunlu, production'da bu olmadan panel açılmaz)
ADMIN_PASSWORD=
# İsteğe bağlı: oturum imzası için ayrı uzun rastgele bir değer
SESSION_SECRET=

# ─── WhatsApp (Meta Cloud API) ─────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Kendi uydurduğunuz gizli kelime; Meta webhook ayarına da aynısını girin
WHATSAPP_VERIFY_TOKEN=

# Bota yazabilecek numaralar, virgülle (boş bırakılırsa herkes yazabilir)
# Örn: 905321234567,905441112233  ("0532 123 45 67" biçimi de kabul edilir)
ALLOWED_NUMBERS=
# "Yetkiliye bağlan" bildirimlerinin gideceği numara
OWNER_NUMBER=

# ─── AI (NVIDIA) ───────────────────────────────────────
# build.nvidia.com → API Keys. Tanımlıysa AI bu anahtarla çalışır.
NVIDIA_API_KEY=
# NVIDIA'daki model kimliği. Varsayılan: meta/llama-3.3-70b-instruct
# Mevcut modelleri görmek için: node scripts/nvidia-models.mjs
AI_MODEL=
# AI'yi tamamen kapatmak için true yapın (sadece hazır cevaplar)
AI_DISABLED=
# (Alternatif) NVIDIA_API_KEY yoksa Vercel AI Gateway kullanılır
AI_GATEWAY_API_KEY=

# ─── Kalıcı hafıza (isteğe bağlı) ──────────────────────
# Upstash Redis eklendiğinde Vercel otomatik doldurur. Boşsa hafıza geçicidir.
REDIS_URL=

# ─── zuulab.com entegrasyonu (kapıda ödeme sipariş onayı) ───
# zuulab.com adresi; müşterinin "Onaylıyorum" cevabı buraya iletilir
ZUULAB_SITE_URL=https://www.zuulab.com
# İki projede de AYNI olmalı (zuulab-e: WHATSAPP_BRIDGE_SECRET). Üretmek için: openssl rand -hex 32
WHATSAPP_BRIDGE_SECRET=
# Meta'daki şablon adları farklıysa (varsayılanlar panelde "sipariş onayı" sayfasında)
WA_TEMPLATE_COD_REQUEST=
WA_TEMPLATE_COD_REMINDER=
WA_TEMPLATE_COD_CANCELLED=

# ─── Hazır cevapların kalıcı deposu ───
# Panelden eklenen/düzenlenen/silinen sorular burada saklanır. Vercel'de Upstash Redis ekleyin:
#   vercel link && vercel integration add upstash/upstash-kv
# REDIS_URL kendiliğinden tanımlanır (sohbet hafızası da aynı Redis'i kullanır).
# Lokal geliştirmede (npm run dev) Redis yoksa .data/knowledge.json dosyasına yazılır.
# Kendi sunucunuzda production'da dosyaya yazmak için: KB_FILE_STORE=true
